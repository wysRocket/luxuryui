{
  "name": "luxuryui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "sources:screensdesign:intake": "node scripts/sources/screensdesign-intake.mjs",
    "sources:screensdesign:normalize": "node scripts/sources/screensdesign-normalize.mjs",
    "sources:screensdesign:normalize:full": "node scripts/sources/screensdesign-normalize.mjs --full",
    "sources:screensdesign:integrity": "node scripts/sources/screensdesign-asset-integrity.mjs",
    "sources:screensdesign:flow-packs": "node scripts/sources/screensdesign-flow-packs.mjs",
    "sources:screensdesign:sync-assets": "node scripts/sources/screensdesign-sync-assets.mjs",
    "commercial:generate:stitch": "node scripts/commercial/generate-stitch-kits.mjs",
    "commercial:rebuild:figma": "node scripts/commercial/rebuild-figma-kits.mjs",
    "commercial:package": "npm run commercial:rebuild:figma && npm run build",
    "commercial:generate": "node scripts/commercial/generate-figma-kits.mjs",
    "commercial:readiness": "node scripts/commercial/validate-commercial-readiness.mjs",
    "pipeline:health": "node scripts/ci-pipeline-health.mjs",
    "firebase:login": "npx -y firebase-tools@latest login",
    "firebase:domain:help": "node scripts/firebase-domain-help.mjs",
    "firebase:deploy:rules": "npx -y firebase-tools@latest deploy --only firestore:rules",
    "assets:fetch": "node scripts/fetch-real-assets.mjs",
    "assets:optimize": "node scripts/optimize-local-assets.mjs",
    "assets:audit": "node scripts/asset-audit.mjs",
    "assets:sync": "npm run assets:fetch && npm run assets:optimize",
    "zip": "cd dist && zip -r ../dist.zip . && cd ..",
    "deploy": "npm run build && npm run zip && node scripts/deploy.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.42.0",
    "@google/stitch-sdk": "^0.1.0",
    "@tailwindcss/vite": "^4.2.1",
    "firebase": "^12.11.0",
    "framer-motion": "^12.34.2",
    "google-play-scraper": "^10.1.2",
    "lucide-react": "^0.575.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^6.30.3",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "sharp": "^0.34.5",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.2"
  }
}
