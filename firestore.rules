rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function adminRolePath() {
      return /databases/$(database)/documents/userRoles/$(request.auth.uid);
    }

    function isAdmin() {
      return isSignedIn()
        && exists(adminRolePath())
        && get(adminRolePath()).data.roles.hasAny(['admin']);
    }

    match /userProfiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId);
    }

    match /userRoles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.roles.hasOnly(['user']);
      allow update: if isAdmin();
    }

    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Clients may create wallet (balance must start at 0) or update it
      // only when balance is decreasing or unchanged (kit purchases).
      // Balance increases require a server-side write via Cloud Functions.
      allow create: if isOwner(userId)
        && request.resource.data.balance == 0;
      allow update: if isOwner(userId)
        && request.resource.data.balance <= resource.data.balance;

      match /transactions/{transactionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
      }

      // topUps are only written by Cloud Functions (Admin SDK bypasses rules).
      // Clients must not create top-up records directly.
      match /topUps/{topUpId} {
        allow read: if isOwner(userId) || isAdmin();
      }

      match /orders/{orderId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId);
      }

      match /unlocks/{unlockId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId);
      }
    }
  }
}
