VITE_BACKEND_MODE=local
VITE_PAYMENT_MODE=local

# Optional live concierge
VITE_GEMINI_API_KEY=

# Stitch commercial pipeline
STITCH_API_KEY=
STITCH_DEFAULT_MODEL=
COMMERCIAL_OUTPUT_ROOT=data/curation/commercial

# Azure OpenAI Foundry image refinement (scripts/sources/screensdesign-refine-assets-foundry.mjs)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_IMAGE_DEPLOYMENT=
AZURE_OPENAI_IMAGE_API_VERSION=2025-04-01-preview

# Required only when VITE_BACKEND_MODE=firebase
# Firebase mode uses a real Firebase project in this phase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# Optional Firebase auth readiness hints (recommended in Firebase mode)
VITE_FIREBASE_GOOGLE_AUTH_ENABLED=
VITE_FIREBASE_AUTHORIZED_DOMAINS=

# Required only when VITE_PAYMENT_MODE=stripe
VITE_STRIPE_PUBLISHABLE_KEY=

# Figma Kit Publisher (scripts/commercial/publish-to-figma.mjs)
# Get your token at: https://www.figma.com/settings → Personal access tokens
FIGMA_ACCESS_TOKEN=
# Same token, used by the figma-developer-mcp server (read-only Figma MCP)
FIGMA_API_KEY=
# Your Figma team ID (found in figma.com/files/team/{TEAM_ID})
FIGMA_TEAM_ID=
